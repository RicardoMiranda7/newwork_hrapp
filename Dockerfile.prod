# --- Stage 1: Build the React Frontend ---
FROM node:22-alpine AS builder-frontend

WORKDIR /app/frontend

# Copy package files and install dependencies
COPY frontend/package.json frontend/package-lock.json ./
RUN npm install

# Copy the rest of the frontend code and build for production
COPY frontend/ ./
# This creates a 'dist' folder with optimized static files
RUN npm run build

# --- Stage 2: Final Production Image ---
FROM python:3.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y nginx postgresql-client && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (including gunicorn)
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install gunicorn

# Copy the backend application code
COPY backend/ ./

# Copy the BUILT frontend files from the frontend builder stage
COPY --from=builder-frontend /app/frontend/dist /var/www/frontend

# Copy configurations and scripts
COPY nginx.conf /etc/nginx/sites-available/default
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Run Django management commands
RUN python manage.py collectstatic --noinput

# Expose the port Nginx will listen on
EXPOSE 80

# Run the entrypoint script
CMD ["/entrypoint.sh"]