# --- Stage 1: Build the React Frontend ---
FROM node:20-alpine AS builder-frontend

WORKDIR /app/frontend

# Copy package files and install dependencies
COPY frontend/package.json frontend/package-lock.json ./
RUN npm install

# Copy the rest of the frontend code and build for production
COPY frontend/ ./
# This creates a 'dist' folder with optimized static files
RUN npm run build


# --- Stage 2: Build the Python Backend ---
FROM python:3.13-slim AS builder-backend

WORKDIR /app

# Install Python dependencies
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy the backend application code
COPY backend/ ./


# --- Stage 3: Final Production Image ---
FROM python:3.13-slim

WORKDIR /app

# Install Nginx and Gunicorn
RUN apt-get update && apt-get install -y nginx
RUN pip install gunicorn

# Copy Python dependencies from the backend builder stage
COPY --from=builder-backend /usr/local/lib/python3.13/site-packages/ /usr/local/lib/python3.13/site-packages/

# Copy the backend application code from the backend builder stage
COPY --from=builder-backend /app /app

# Copy the BUILT frontend files from the frontend builder stage into the Nginx serve directory
COPY --from=builder-frontend /app/frontend/dist /var/www/frontend

# Copy the Nginx configuration file
COPY nginx.conf /etc/nginx/sites-available/default

# Copy the entrypoint script that will start the services
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Run Django management commands
RUN python manage.py collectstatic --noinput

# Expose the port Nginx will listen on
EXPOSE 80

# Run the entrypoint script
CMD ["/entrypoint.sh"]